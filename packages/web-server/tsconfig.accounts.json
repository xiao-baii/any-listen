{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "composite": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@any-listen/types", "@any-listen/app", "@any-listen/nodejs/node_modules/@types/node"],
    "paths": { "@/*": ["./src/*"], "better-sqlite3": ["../shared/app/node_modules/@types/better-sqlite3/index.d.ts"] }
  },
  "references": [],
  "include": [
    "src/types/*.d.ts",
    "src/app/types/*.d.ts",
    "../shared/app/types/common.d.ts",
    "../shared/nodejs/publicNetwork.ts",
    "src/accounts/database.ts",
    "src/accounts/bootstrap.ts",
    "src/accounts/gateway.ts",
    "src/accounts/runtime.ts",
    "src/accounts/migration.ts",
    "src/accounts/publications.ts",
    "src/accounts/security.ts",
    "src/accounts/managed.ts"
  ]
}
