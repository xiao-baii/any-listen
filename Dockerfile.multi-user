FROM node:24-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
WORKDIR /src
COPY . .
RUN test -s packages/view-main/.env.web && test -s packages/view-lyric/.env.web && test -s packages/web-server/.env.web
ENV SKIP_LIB_COPY=1 ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN pnpm install --frozen-lockfile
RUN SKIP_LIB_COPY= pnpm build:web
RUN node packages/web-server/tests/run.cjs

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /src/build ./
RUN mkdir /data && chown node:node /data
USER node
ENV NODE_ENV=production MULTI_USER=true DATA_PATH=/data PORT=9500
EXPOSE 9500
VOLUME /data
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:9500/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--", "node", "index.cjs"]
